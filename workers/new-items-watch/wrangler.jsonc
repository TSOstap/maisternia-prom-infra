// «Сторож новинок» — Cloudflare Free, SQLite Durable Object. НЕ РОЗГОРНУТО. Розгортання — лише з окремого погодження власника.
{
  "name": "mm-new-items-watch",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-01",
  // node:crypto (SHA-256 для відбитків) — через сумісність Node.js у Workers.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Cron Triggers НЕ використовуються. Автоматичні перевірки — alarm Durable Object (вимкнено, див. ALARMS_ALLOWED).
  "triggers": { "crons": [] },
  "durable_objects": {
    "bindings": [{ "name": "WATCH_DO", "class_name": "WatchDO" }]
  },
  // Free: лише Durable Objects зі сховищем SQLite.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WatchDO"] }],
  "vars": {
    "GITHUB_REPO": "TSOstap/maisternia-prom-infra",
    "GITHUB_WORKFLOW": "sheets-verify.yml",
    "GITHUB_REF": "main",
    "GITHUB_MODE": "copy-intake",
    "FEED_PROFILE": "medium"
    // "ALARMS_ALLOWED": "yes" — лише після окремого погодження; без неї POST /schedule {"on":true} відхиляється.
  }
  // Секрети (додає власник через `wrangler secret put`, не в репозиторій): SUPPLIER_FEED_URL, WATCH_KEY, GITHUB_TOKEN.
}
