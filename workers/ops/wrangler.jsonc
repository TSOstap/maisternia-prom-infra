// «mm-ops» — диспетчер кнопок таблиці TEST + сховище W2 (ENG-29). Cloudflare Workers Free, SQLite Durable Object.
// Cron Triggers немає: автопошук новинок — alarm самого Durable Object (вмикає оператор: POST /admin/watch).
{
  "name": "mm-ops",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-01",
  // node:crypto (відбитки W2 / CC) і Buffer у спільному коді — для «Ціни й наявність» на сервері (prices-job.mjs).
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "triggers": { "crons": ["*/30 * * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "OPS_DO", "class_name": "OpsDO" }]
  },
  // Free: лише Durable Objects зі сховищем SQLite.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OpsDO"] }],
  "vars": {
    "GITHUB_REPO": "TSOstap/maisternia-prom-infra",
    "GITHUB_WORKFLOW": "ops.yml",
    "GITHUB_REF": "main",
    // «Оновити ціни й наявність» — через GitHub (ops.yml): 25.11 власник «так» — репозиторій публічний (хвилини без ліміту), а на сервері
    // запуск зі змінами зависав через пам'ять. "do" — на цьому сервері (Durable Object), як було з 03.11.
    "PRICES_RUNNER": "github"
  }
  // Секрети (wrangler secret put, не в репозиторій): BUTTON_KEY, RUNNER_KEY, ADMIN_KEY, GITHUB_TOKEN, SUPPLIER_FEED_URL, GOOGLE_SA_KEY
  // (JSON ключа сервісного акаунта mm-sheets-copy — «Ціни й наявність» на сервері). PRICES_RUNNER="do" — кнопка «Ціни» виконується тут.
}
